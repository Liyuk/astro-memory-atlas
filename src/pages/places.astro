---
import { readFile } from 'node:fs/promises';
import path from 'node:path';
import { getImage } from 'astro:assets';
import { getAlbumImageOptions, getTimelineImages } from '../lib/image-assets.js';
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE_CONFIG } from '../config/site.js';

const fallbackMarkup = await readFile(path.resolve('src/generated/atlas-memory-index.html'), 'utf8');
const siteBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const optimizedImages = new Map(await Promise.all(getTimelineImages().map(async ({ path: imagePath, image }) => {
  const [thumbnail, viewer] = await Promise.all([
    getImage({ src: image, ...getAlbumImageOptions(image, {
      width: 390,
      widths: [96, 192, 320, 480],
      sizes: '96px',
    }) }),
    getImage({ src: image, format: 'webp', quality: 85, width: Math.min(image.width, 2048) }),
  ]);
  return [imagePath, {
    src: thumbnail.src,
    srcSet: thumbnail.srcSet.attribute,
    width: thumbnail.attributes.width,
    height: thumbnail.attributes.height,
    viewerSrc: viewer.src,
    viewerWidth: viewer.attributes.width,
    viewerHeight: viewer.attributes.height,
  }];
})));
const fallbackMemoryLinks = fallbackMarkup.replace(/<img\b([^>]*?)src="[^"]*assets\/images\/(?:demo\/|timeline\/)([^"]+)"([^>]*)>/g, (_match, before, filename, after) => {
  const image = optimizedImages.get(`demo/${filename}`);
  if (!image) throw new Error(`No optimized image for demo/${filename}`);
  return `<img${before}src="${image.src}" srcset="${image.srcSet}" sizes="96px" width="${image.width}" height="${image.height}" data-pswp-src="${image.viewerSrc}" data-pswp-width="${image.viewerWidth}" data-pswp-height="${image.viewerHeight}"${after}>`;
});
---
<SiteLayout
  title={`地图足迹 · ${SITE_CONFIG.brand.name}`}
  description="在虚构地图上浏览示例地点和关联记忆。"
  themeColor="#f4efe5"
  current="places"
  bodyClass="theme-atlas"
>
  <link slot="head" rel="stylesheet" href={`${siteBase}places/vendor/leaflet.css`}>
  <link slot="head" rel="stylesheet" href={`${siteBase}places/vendor/MarkerCluster.css`}>
  <link slot="head" rel="stylesheet" href={`${siteBase}places/map.css`}>
  <a class="skip-link" href="#atlas-map">跳到地图</a>
  <header class="atlas-header">
    <a class="back-link" href={siteBase} aria-label="回到首页"><svg class="icon" aria-hidden="true"><use href="#icon-arrow-left"/></svg><span>回到首页</span></a>
    <h1>把回忆里的地点，<em>标在地图上。</em></h1>
    <p class="atlas-intro">点击示例地点查看关联记忆，也可以按时间浏览。</p>
  </header>

  <main id="memory-atlas" class="atlas-layout">
    <section class="map-column" aria-labelledby="map-heading">
      <div class="map-heading-row">
        <div><p class="eyebrow">我们的足迹</p><h2 id="map-heading">旅行地图</h2></div>
      </div>
      <div class="map-controls-row">
        <label class="atlas-location-picker" for="atlas-location-picker">
          <span>按旅行区域找</span>
          <span class="select-control">
            <select id="atlas-location-picker" data-atlas-location>
              <option value="">选择一个城市或地点</option>
            </select>
            <svg class="icon select-control__icon" aria-hidden="true" focusable="false"><use href="#icon-chevron-down"></use></svg>
          </span>
        </label>
        <div class="map-toolbar">
          <p class="map-hint">拖动地图 · 点击标记 · 使用缩放控件</p>
          <button type="button" class="atlas-overview-button" data-atlas-overview hidden><svg class="icon" aria-hidden="true"><use href="#icon-map"/></svg><span>显示全部足迹</span></button>
        </div>
      </div>
      <div id="atlas-map" class="atlas-map" role="region" aria-label="可缩放的旅行足迹地图"></div>
      <noscript><p>互动地图需要 JavaScript；下方仍可浏览照片缩略图并打开对应相册故事。</p></noscript>
      <p class="map-disclaimer">这是一张按回忆整理的插画地图，地点只展示大致方位，不用于导航、测距或表示精确地址；跨城回忆可关联多个标记。</p>
    </section>

    <aside class="memory-column" aria-label="地图记忆">
      <section id="atlas-viewer" class="atlas-viewer" tabindex="-1" aria-live="polite" aria-atomic="true">
        <p class="atlas-viewer-empty"><svg class="icon" aria-hidden="true"><use href="#icon-map-pin"/></svg><span>从一处足迹开始</span><small>点击地图标记，或从上方选择城市，打开对应回忆。</small></p>
      </section>
      <section class="memory-index" aria-labelledby="memory-index-heading">
        <div class="section-heading"><p class="eyebrow">快速定位</p><h2 id="memory-index-heading">按时间与地点跳转</h2></div>
        <ol id="atlas-memory-list" class="atlas-memory-list" aria-label="沿时间轴按地点和日期快速跳转">
          <Fragment set:html={fallbackMemoryLinks} />
        </ol>
      </section>
    </aside>

  </main>

  <footer class="atlas-footer">两个人的记忆地图 · 虚构示例</footer>
  <script is:inline src={`${siteBase}places/vendor/leaflet.js`} defer></script>
  <script is:inline src={`${siteBase}places/vendor/leaflet.markercluster.js`} defer></script>
  <script>
    import '../scripts/places-page.js';
  </script>
</SiteLayout>
