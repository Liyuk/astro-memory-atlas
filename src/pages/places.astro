---
import { readFile } from 'node:fs/promises';
import path from 'node:path';
import { getImage } from 'astro:assets';
import { getAlbumImageOptions, getTimelineImages } from '../lib/image-assets.js';
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE_CONFIG } from '../config/site.js';
import LocalizedText from '../components/LocalizedText.astro';
import { COPY } from '../i18n/copy.js';

const fallbackMarkup = await readFile(path.resolve('src/generated/atlas-memory-index.html'), 'utf8');
const siteBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const optimizedImages = new Map(await Promise.all(getTimelineImages().map(async ({ path: imagePath, image }) => {
  const [thumbnail, viewer] = await Promise.all([
    getImage({ src: image, ...getAlbumImageOptions(image, {
      width: 390,
      widths: [96, 192, 320, 480],
      sizes: '96px',
    }) }),
    getImage({ src: image, format: 'webp', quality: 85, width: Math.min(image.width, 2048) }),
  ]);
  return [imagePath, {
    src: thumbnail.src,
    srcSet: thumbnail.srcSet.attribute,
    width: thumbnail.attributes.width,
    height: thumbnail.attributes.height,
    viewerSrc: viewer.src,
    viewerWidth: viewer.attributes.width,
    viewerHeight: viewer.attributes.height,
  }];
})));
const fallbackMemoryLinks = fallbackMarkup.replace(/<img\b([^>]*?)src="[^"]*assets\/images\/(?:demo\/|timeline\/)([^"]+)"([^>]*)>/g, (_match, before, filename, after) => {
  const image = optimizedImages.get(`demo/${filename}`);
  if (!image) throw new Error(`No optimized image for demo/${filename}`);
  return `<img${before}src="${image.src}" srcset="${image.srcSet}" sizes="96px" width="${image.width}" height="${image.height}" data-pswp-src="${image.viewerSrc}" data-pswp-width="${image.viewerWidth}" data-pswp-height="${image.viewerHeight}"${after}>`;
});
---
<SiteLayout
  title={{ zh: `${COPY['places.title'].zh} · ${SITE_CONFIG.brand.name.zh}`, en: `${COPY['places.title'].en} · ${SITE_CONFIG.brand.name.en}` }}
  description={{ zh: '在虚构地图上浏览示例地点和关联记忆。', en: 'Browse fictional sample places and related memories on an illustrated map.' }}
  themeColor="#f4efe5"
  current="places"
  bodyClass="theme-atlas"
>
  <link slot="head" rel="stylesheet" href={`${siteBase}places/vendor/leaflet.css`}>
  <link slot="head" rel="stylesheet" href={`${siteBase}places/vendor/MarkerCluster.css`}>
  <link slot="head" rel="stylesheet" href={`${siteBase}places/map.css`}>
  <a class="skip-link" href="#atlas-map" aria-label="跳到地图" data-locale-aria-label-zh="跳到地图" data-locale-aria-label-en="Skip to map"><LocalizedText value={{ zh: '跳到地图', en: 'Skip to map' }} /></a>
  <header class="atlas-header">
    <a class="back-link" href={siteBase} aria-label={COPY['places.backHome'].zh} data-locale-aria-label-zh={COPY['places.backHome'].zh} data-locale-aria-label-en={COPY['places.backHome'].en}><svg class="icon" aria-hidden="true"><use href="#icon-arrow-left"/></svg><span><LocalizedText value={COPY['places.backHome']} /></span></a>
    <h1><LocalizedText value={COPY['places.heading']} /></h1>
    <p class="atlas-intro"><LocalizedText value={COPY['places.intro']} /></p>
  </header>

  <main id="memory-atlas" class="atlas-layout">
    <section class="map-column" aria-labelledby="map-heading">
      <div class="map-heading-row">
        <div><p class="eyebrow"><LocalizedText value={COPY['places.ourPlaces']} /></p><h2 id="map-heading"><LocalizedText value={COPY['places.map']} /></h2></div>
      </div>
      <div class="map-controls-row">
        <label class="atlas-location-picker" for="atlas-location-picker">
          <span><LocalizedText value={COPY['places.byArea']} /></span>
          <span class="select-control">
            <select id="atlas-location-picker" data-atlas-location>
              <option value="" data-locale-option-zh={COPY['places.choose'].zh} data-locale-option-en={COPY['places.choose'].en}>{COPY['places.choose'].zh}</option>
            </select>
            <svg class="icon select-control__icon" aria-hidden="true" focusable="false"><use href="#icon-chevron-down"></use></svg>
          </span>
        </label>
        <div class="map-toolbar">
          <p class="map-hint"><LocalizedText value={COPY['places.mapHint']} /></p>
          <button type="button" class="atlas-overview-button" data-atlas-overview hidden><svg class="icon" aria-hidden="true"><use href="#icon-map"/></svg><span><LocalizedText value={COPY['places.showAll']} /></span></button>
        </div>
      </div>
      <div id="atlas-map" class="atlas-map" role="region" aria-label={COPY['places.mapRegion'].zh} data-locale-aria-label-zh={COPY['places.mapRegion'].zh} data-locale-aria-label-en={COPY['places.mapRegion'].en}></div>
      <noscript><p><LocalizedText value={COPY['places.noScript']} /></p></noscript>
      <p class="map-disclaimer"><LocalizedText value={COPY['places.disclaimer']} /></p>
    </section>

    <aside class="memory-column" aria-label={COPY['places.memoryList'].zh} data-locale-aria-label-zh={COPY['places.memoryList'].zh} data-locale-aria-label-en={COPY['places.memoryList'].en}>
      <section id="atlas-viewer" class="atlas-viewer" tabindex="-1" aria-live="polite" aria-atomic="true">
        <p class="atlas-viewer-empty"><svg class="icon" aria-hidden="true"><use href="#icon-map-pin"/></svg><span><LocalizedText value={COPY['places.startHere']} /></span><small><LocalizedText value={COPY['places.selectHint']} /></small></p>
      </section>
      <section class="memory-index" aria-labelledby="memory-index-heading">
        <div class="section-heading"><p class="eyebrow"><LocalizedText value={COPY['places.quickFind']} /></p><h2 id="memory-index-heading"><LocalizedText value={COPY['places.jumpByDate']} /></h2></div>
        <ol id="atlas-memory-list" class="atlas-memory-list" aria-label={COPY['places.timelineList'].zh} data-locale-aria-label-zh={COPY['places.timelineList'].zh} data-locale-aria-label-en={COPY['places.timelineList'].en}>
          <Fragment set:html={fallbackMemoryLinks} />
        </ol>
      </section>
    </aside>

  </main>

  <footer class="atlas-footer"><LocalizedText value={{ zh: '两个人的记忆地图 · 虚构示例', en: 'A Memory Atlas for Two · Fictional demo' }} /></footer>
  <script is:inline src={`${siteBase}places/vendor/leaflet.js`} defer></script>
  <script is:inline src={`${siteBase}places/vendor/leaflet.markercluster.js`} defer></script>
  <script>
    import '../scripts/places-page.js';
  </script>
</SiteLayout>
