---
import AnnualReview from '../../components/AnnualReview.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { SITE_CONFIG } from '../../config/site.js';
import { COPY } from '../../i18n/copy.js';
import LocalizedText from '../../components/LocalizedText.astro';
import '../../styles/annual-review.css';
---
<SiteLayout
  title={{ zh: `${COPY['annual.title'].zh} · ${SITE_CONFIG.brand.name.zh}`, en: `${COPY['annual.title'].en} · ${SITE_CONFIG.brand.name.en}` }}
  description={{ zh: COPY['annual.intro'].zh, en: COPY['annual.intro'].en }}
  current="annual"
>
  <a class="skip-link" href="#annual-review" aria-label="跳到年度回顾" data-locale-aria-label-zh="跳到年度回顾" data-locale-aria-label-en="Skip to Year in Review"><LocalizedText value={{ zh: '跳到年度回顾', en: 'Skip to Year in Review' }} /></a>
  <AnnualReview />
</SiteLayout>
