---
import AnnualReview from '../../components/AnnualReview.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { SITE_CONFIG } from '../../config/site.js';
import { COPY } from '../../i18n/copy.js';
import '../../styles/annual-review.css';
---
<SiteLayout
  title={{ zh: `${COPY['annual.title'].zh} · ${SITE_CONFIG.brand.name.zh}`, en: `${COPY['annual.title'].en} · ${SITE_CONFIG.brand.name.en}` }}
  description={{ zh: COPY['annual.intro'].zh, en: COPY['annual.intro'].en }}
  current="annual"
>
  <AnnualReview />
</SiteLayout>
