---
import Hero from '../components/home/Hero.astro';
import StoryFilm from '../components/home/StoryFilm.astro';
import FeaturedMemories from '../components/home/FeaturedMemories.astro';
import HomeOverlays from '../components/home/HomeOverlays.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getImage } from 'astro:assets';
import { SITE_CONFIG } from '../config/site.js';
import { getAlbumImageOptions, resolveAlbumImage, selectImagePreset } from '../lib/image-assets.js';
import '../styles/home.css';
const heroSource = resolveAlbumImage('demo/river.jpg');
const heroPreset = selectImagePreset({ variant: 'hero' });
const heroImage = await getImage({ src: heroSource, ...getAlbumImageOptions(heroSource, heroPreset) });
---
<SiteLayout
  title={SITE_CONFIG.brand.name}
  description={SITE_CONFIG.brand.description}
  current="story"
>
  <link slot="head" rel="preload" as="image" href={heroImage.src} imagesrcset={heroImage.srcSet.attribute} imagesizes={heroImage.attributes.sizes} fetchpriority="high">
  <main class="page" id="main-content" tabindex="-1">
    <Hero />
    <StoryFilm />
    <FeaturedMemories />
    <HomeOverlays />
  </main>
  <script>
    import '../scripts/home.js';
  </script>
</SiteLayout>
