---
import MemoryArchive from '../../components/home/MemoryArchive.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { SITE_CONFIG } from '../../config/site.js';
import { COPY } from '../../i18n/copy.js';
import LocalizedText from '../../components/LocalizedText.astro';
import '../../styles/home.css';
const siteBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<SiteLayout
  title={{ zh: `${COPY['album.title'].zh} · ${SITE_CONFIG.brand.name.zh}`, en: `${COPY['album.title'].en} · ${SITE_CONFIG.brand.name.en}` }}
  description={{ zh: '按日期和地点浏览虚构示例记忆。', en: 'Browse fictional sample memories by date and place.' }}
  themeColor="#f5eee4"
  current="album"
  baseHref={siteBase}
>
  <main class="page album-page">
    <p class="album-back"><a class="scene-link" href={siteBase}><LocalizedText value={COPY['album.back']} /></a></p>
    <MemoryArchive />
  </main>
  <script>
    import '../../scripts/album.js';
  </script>
</SiteLayout>
