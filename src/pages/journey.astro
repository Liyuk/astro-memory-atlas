---
import JourneyTimeline from '../components/JourneyTimeline.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE_CONFIG } from '../config/site.js';
import { COPY } from '../i18n/copy.js';
import '../styles/journey-timeline.css';
---
<SiteLayout
  title={{ zh: `${COPY['journey.title'].zh} · ${SITE_CONFIG.brand.name.zh}`, en: `${COPY['journey.title'].en} · ${SITE_CONFIG.brand.name.en}` }}
  description={{ zh: '浏览林岚和周屿这份虚构示例中的关系阶段和共同记忆。', en: 'Explore the fictional relationship milestones and memories of Lin Lan and Zhou Yu.' }}
  current="journey"
>
  <main class="journey-shell" id="main-content" tabindex="-1">
    <JourneyTimeline />
  </main>
</SiteLayout>
