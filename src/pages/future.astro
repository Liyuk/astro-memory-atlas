---
import SharedWishes from '../components/SharedWishes.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE_CONFIG } from '../config/site.js';
import { COPY } from '../i18n/copy.js';
import '../styles/shared-wishes.css';
---
<SiteLayout
  title={{ zh: `${COPY['future.title'].zh} · ${SITE_CONFIG.brand.name.zh}`, en: `${COPY['future.title'].en} · ${SITE_CONFIG.brand.name.en}` }}
  description={{ zh: '浏览并编辑这份虚构示例中的未来愿望清单。', en: 'Browse and edit the fictional sample list of future wishes.' }}
  current="future"
>
  <SharedWishes />
</SiteLayout>
