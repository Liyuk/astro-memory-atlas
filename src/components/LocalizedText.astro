---
const { value, class: className, values = {} } = Astro.props;
const format = (input, language) => Object.entries(values).reduce((result, [name, replacement]) => {
  const resolved = typeof replacement === 'object' && replacement !== null ? replacement[language] ?? replacement.zh ?? replacement.en : replacement;
  return result.replaceAll(`{${name}}`, String(resolved));
}, input);
const zh = format(typeof value === 'string' ? value : value?.zh ?? value?.en ?? '', 'zh');
const en = format(typeof value === 'string' ? value : value?.en ?? value?.zh ?? '', 'en');
---
<span class={className}>
  <span lang="zh-CN" data-locale-copy="zh">{zh}</span>
  <span lang="en" data-locale-copy="en" hidden>{en}</span>
</span>
