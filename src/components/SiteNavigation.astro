---
import LocalizedText from './LocalizedText.astro';
import { COPY } from '../i18n/copy.js';
const { current = 'story' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const links = [
  { id: 'story', href: `${base}#opening`, label: COPY['nav.story'] },
  { id: 'journey', href: `${base}journey/`, label: COPY['nav.journey'] },
  { id: 'album', href: `${base}album/#memory-search`, label: COPY['nav.album'] },
  { id: 'annual', href: `${base}annual/`, label: COPY['nav.annual'] },
  { id: 'places', href: `${base}places/`, label: COPY['nav.places'] },
  { id: 'future', href: `${base}future/`, label: COPY['nav.future'] },
];
---
<nav class="site-navigation" aria-label={COPY['nav.label'].zh} data-locale-aria-label-zh={COPY['nav.label'].zh} data-locale-aria-label-en={COPY['nav.label'].en}>
  <a class="site-navigation-name" href={`${base}#opening`}><LocalizedText value={COPY['brand.name']} /></a>
  <div class="site-navigation-links" tabindex="0" aria-label={COPY['nav.browse'].zh} data-locale-aria-label-zh={COPY['nav.browse'].zh} data-locale-aria-label-en={COPY['nav.browse'].en}>
    {links.map(({ id, href, label }) => (
      <a href={href} aria-current={current === id ? 'page' : undefined}><LocalizedText value={label} /></a>
    ))}
  </div>
  <div class="site-language-picker" role="group" aria-label={COPY['language.label'].zh} data-locale-aria-label-zh={COPY['language.label'].zh} data-locale-aria-label-en={COPY['language.label'].en}>
    <button type="button" data-language-choice="zh" aria-pressed="true">中文</button>
    <button type="button" data-language-choice="en" aria-pressed="false">EN</button>
  </div>
</nav>
<script>
  const navigation = document.querySelector<HTMLElement>('.site-navigation');
  const updateNavigationSurface = () => {
    navigation?.classList.toggle('site-navigation--scrolled', window.scrollY > 32);
  };
  updateNavigationSurface();
  window.addEventListener('scroll', updateNavigationSurface, { passive: true });

  const currentLink = document.querySelector<HTMLElement>('.site-navigation-links [aria-current="page"]');
  const links = currentLink?.parentElement;
  if (currentLink && links instanceof HTMLElement) {
    const linkBounds = currentLink.getBoundingClientRect();
    const stripBounds = links.getBoundingClientRect();
    const alreadyVisible = linkBounds.left >= stripBounds.left && linkBounds.right <= stripBounds.right;
    if (!alreadyVisible) currentLink.scrollIntoView({ block: 'nearest', inline: 'nearest' });
  }
</script>
