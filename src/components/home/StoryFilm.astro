---
import OptimizedImage from '../OptimizedImage.astro';
import LocalizedText from '../LocalizedText.astro';
import { SITE_CONFIG } from '../../config/site.js';
import { COPY } from '../../i18n/copy.js';
import { memories, getMemoryById } from '../../data/memories.js';
const featured = ['first-walk', 'garden-picnic', 'small-celebration'].map(getMemoryById);
const { love, wedding } = SITE_CONFIG.anniversaries;
const siteBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<div class="story-film" aria-label={COPY['hero.accessible'].zh} data-locale-aria-label-zh={COPY['hero.accessible'].zh} data-locale-aria-label-en={COPY['hero.accessible'].en}>
  {featured.map((memory, index) => <section class="story-scene" id={index === 0 ? 'story-first-walk' : `story-${memory.id}`} aria-labelledby={`story-${memory.id}-title`}>
    <div class="scene-copy"><p class="scene-date">{memory.date}</p><h2 id={`story-${memory.id}-title`}><LocalizedText value={memory.title} /></h2><p><LocalizedText value={memory.description} /></p>
      {index === 0 && <section class="anniversary-card" aria-labelledby="love-title"><p class="date-label"><LocalizedText value={COPY['common.anniversary']} /></p><h3 id="love-title"><LocalizedText value={love.label} /></h3><time class="anniversary-date" datetime={love.date}>{love.date.replaceAll('-', '.')}</time><div class="timer" aria-label={COPY['status.anniversary'].zh} data-locale-aria-label-zh={COPY['status.anniversary'].zh} data-locale-aria-label-en={COPY['status.anniversary'].en} data-start={love.startAt}><div class="time-unit"><strong class="time-value" data-unit="days">0</strong><small><LocalizedText value={COPY['common.days']} /></small></div><div class="time-unit"><strong class="time-value" data-unit="hours">00</strong><small><LocalizedText value={{ zh: '小时', en: 'hours' }} /></small></div><div class="time-unit"><strong class="time-value" data-unit="minutes">00</strong><small><LocalizedText value={{ zh: '分钟', en: 'minutes' }} /></small></div><div class="time-unit"><strong class="time-value" data-unit="seconds">00</strong><small><LocalizedText value={{ zh: '秒', en: 'seconds' }} /></small></div></div><button class="anniversary-replay" type="button" data-anniversary-open="love"><LocalizedText value={{ zh: '重看这段回忆', en: 'Revisit this memory' }} /></button></section>}
      {index === 1 && <section class="anniversary-card anniversary-card--wedding"><p class="date-label"><LocalizedText value={COPY['common.sampleDate']} /></p><h3><LocalizedText value={wedding.label} /></h3><time class="anniversary-date" datetime={wedding.date}>{wedding.date.replaceAll('-', '.')}</time><button class="anniversary-replay" type="button" data-anniversary-open="wedding"><LocalizedText value={{ zh: '重看这段回忆', en: 'Revisit this memory' }} /></button></section>}
      <a class="scene-link" href={`${siteBase}album/#memory-${memory.id}`}><LocalizedText value={{ zh: '在相册中查看', en: 'View in the album' }} /> <svg class="icon" aria-hidden="true"><use href="#icon-arrow-up-right"></use></svg></a>
    </div>
    <button class="scene-photo memory-image-hover" type="button" data-story-memory={memory.id} aria-label={`打开${memory.title.zh}`} data-locale-aria-label-zh={`打开${memory.title.zh}`} data-locale-aria-label-en={`Open ${memory.title.en}`}><OptimizedImage class="memory-image-frame__image" src={`./assets/images/${memory.image}`} alt={memory.alt} loading={index === 0 ? undefined : 'lazy'} decoding="async" /><span class="scene-photo-caption"><LocalizedText value={memory.place || { zh: '一段虚构记忆', en: 'A fictional memory' }} /></span></button>
  </section>)}
  <p class="journey-ending"><LocalizedText value={COPY['home.storyEnding']} /></p>
</div>
