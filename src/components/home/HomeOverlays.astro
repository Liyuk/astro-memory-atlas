---
import LocalizedText from '../LocalizedText.astro';
---

        <dialog class="anniversary-dialog" id="anniversary-dialog" aria-labelledby="anniversary-dialog-title" aria-describedby="anniversary-dialog-message">
            <div class="anniversary-intro" data-anniversary-intro aria-hidden="true">
                <div class="anniversary-fireworks">
                    <span class="anniversary-firework anniversary-firework--one"></span>
                    <span class="anniversary-firework anniversary-firework--two"></span>
                    <span class="anniversary-firework anniversary-firework--three"></span>
                </div>
                <h2 class="anniversary-intro-title" data-anniversary-intro-title></h2>
            </div>
            <header class="anniversary-dialog-head">
                <button class="anniversary-dialog-close" type="button" data-anniversary-close aria-label="关闭周年回忆" data-locale-aria-label-zh="关闭周年回忆" data-locale-aria-label-en="Close anniversary memory"><svg class="icon"><use href="#icon-x"></use></svg></button>
                <p class="anniversary-dialog-kicker" data-anniversary-kicker></p>
                <h2 class="anniversary-dialog-title" id="anniversary-dialog-title" data-anniversary-title></h2>
                <p class="anniversary-dialog-message" id="anniversary-dialog-message" data-anniversary-message></p>
            </header>
            <div class="anniversary-chapters" data-anniversary-chapters></div>
        </dialog>
        <dialog class="birthday-dialog" id="birthday-dialog" aria-labelledby="birthday-title" aria-describedby="birthday-message">
            <div class="birthday-screen">
                <div class="birthday-sparkles" data-birthday-sparkles aria-hidden="true"></div>
                <button class="birthday-close" type="button" data-birthday-close aria-label="关闭生日祝福" data-locale-aria-label-zh="关闭生日祝福" data-locale-aria-label-en="Close birthday greeting" autofocus><svg class="icon"><use href="#icon-x"></use></svg></button>
                <div class="birthday-content">
                    <p class="birthday-kicker" data-birthday-kicker></p>
                    <h2 class="birthday-title" id="birthday-title" data-birthday-title></h2>
                    <p class="birthday-message" id="birthday-message" data-birthday-message></p>
                    <p class="birthday-signoff"><LocalizedText value={{ zh: '来自记忆地图模板', en: 'From the Memory Atlas template' }} /></p>
                </div>
            </div>
        </dialog>

        <footer class="site-footer" tabindex="-1"><LocalizedText value={{ zh: '两个人的记忆地图 · 虚构示例', en: 'A Memory Atlas for Two · Fictional demo' }} /></footer>
