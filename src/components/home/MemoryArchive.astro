---
import OptimizedImage from '../OptimizedImage.astro';
import LocalizedText from '../LocalizedText.astro';
import { memories } from '../../data/memories.js';
import { COPY } from '../../i18n/copy.js';
---
<section class="story memory-archive" id="memory-album" aria-labelledby="story-title">
  <header class="story-heading">
    <div>
      <p class="section-kicker"><LocalizedText value={COPY['common.sample']} /></p>
      <h2 id="story-title"><LocalizedText value={COPY['home.memoryHeading']} /></h2>
    </div>
    <p class="story-copy"><LocalizedText value={{ zh: '示例内容可按你的故事自由替换', en: 'Replace the sample content with your own story' }} /></p>
    <aside class="memory-nudge" aria-label="今天翻到的一段回忆" data-locale-aria-label-zh="今天翻到的一段回忆" data-locale-aria-label-en="A memory for today">
      <p class="memory-nudge-label"><LocalizedText value={COPY['home.nudge']} /></p>
      <p class="memory-nudge-memory"><strong data-memory-title>{memories[0].title.zh}<span data-locale-copy="en" hidden>{memories[0].title.en}</span></strong><span class="memory-nudge-date" data-memory-date></span></p>
      <button class="memory-nudge-button" type="button" data-memory-jump><LocalizedText value={COPY['home.jump']} /> <span aria-hidden="true"><svg class="icon"><use href="#icon-arrow-up-right"></use></svg></span></button>
    </aside>
  </header>

  <div class="memory-book">
    <div class="book-topline"><span><LocalizedText value={COPY['home.fullAlbum']} /></span><span><LocalizedText value={COPY['home.sampleMemories']} /></span></div>
    <nav class="chapter-nav" aria-label="跳转到相册章节" data-locale-aria-label-zh="跳转到相册章节" data-locale-aria-label-en="Jump to album chapters">
      <button class="chapter-button" type="button" data-chapter="2022" aria-pressed="false"><LocalizedText value={COPY['home.chapter.2022']} /> · 2022</button>
      <button class="chapter-button" type="button" data-chapter="2023" aria-pressed="false"><LocalizedText value={COPY['home.chapter.2023']} /> · 2023</button>
      <button class="chapter-button" type="button" data-chapter="2024" aria-pressed="false"><LocalizedText value={COPY['home.chapter.2024']} /> · 2024</button>
      <button class="chapter-button" type="button" data-chapter="2025" aria-pressed="false"><LocalizedText value={COPY['home.chapter.2025']} /> · 2025</button>
    </nav>
    <div class="memory-tools" id="memory-search" role="search" aria-label="搜索故事相册" data-locale-aria-label-zh="搜索故事相册" data-locale-aria-label-en="Search the memory album">
      <label class="memory-tool"><LocalizedText value={COPY['home.searchLabel']} />
        <input type="search" data-memory-search placeholder={COPY['home.searchPlaceholder'].zh} data-locale-placeholder-zh={COPY['home.searchPlaceholder'].zh} data-locale-placeholder-en={COPY['home.searchPlaceholder'].en} autocomplete="off">
      </label>
      <label class="memory-tool"><LocalizedText value={COPY['home.year']} />
        <span class="select-control">
          <select data-memory-year aria-label={COPY['home.filterYear'].zh} data-locale-aria-label-zh={COPY['home.filterYear'].zh} data-locale-aria-label-en={COPY['home.filterYear'].en}>
            <option value=""><LocalizedText value={COPY['home.allYears']} /></option>
          </select>
          <svg class="icon select-control__icon" aria-hidden="true" focusable="false"><use href="#icon-chevron-down"></use></svg>
        </span>
      </label>
    </div>
    <p class="memory-filter-summary" data-memory-filter-summary aria-live="polite"></p>
    <div class="album-reading-tools" aria-label="相册阅读方式" data-locale-aria-label-zh="相册阅读方式" data-locale-aria-label-en="Album reading controls">
      <button class="album-reading-toggle" type="button" data-album-page-toggle aria-pressed="false"><LocalizedText value={COPY['home.startPageMode']} /></button>
      <div class="album-turn-controls" data-album-turn-controls hidden>
        <button class="album-turn-button" type="button" data-album-previous aria-label={COPY['home.previousPage'].zh} data-locale-aria-label-zh={COPY['home.previousPage'].zh} data-locale-aria-label-en={COPY['home.previousPage'].en}><svg class="icon" aria-hidden="true"><use href="#icon-arrow-left"></use></svg></button>
        <span class="album-turn-progress" data-album-progress aria-live="polite">1 / {memories.length}</span>
        <button class="album-turn-button" type="button" data-album-next aria-label={COPY['home.nextPage'].zh} data-locale-aria-label-zh={COPY['home.nextPage'].zh} data-locale-aria-label-en={COPY['home.nextPage'].en}><svg class="icon" aria-hidden="true"><use href="#icon-arrow-right"></use></svg></button>
      </div>
    </div>
    <div class="book-spread" role="region" aria-label={COPY['home.ourAlbum'].zh} data-locale-aria-label-zh={COPY['home.ourAlbum'].zh} data-locale-aria-label-en={COPY['home.ourAlbum'].en} tabindex="0">
      {memories.map((memory, index) => (
        <article class={index === 0 ? 'memory-entry is-active' : 'memory-entry'} id={`memory-${memory.id}`}>
          <div class="memory-page-layout">
            <div class="memory-entry-art memory-image-frame memory-image-hover">
              <OptimizedImage fullSizeForViewer src={`./assets/images/${memory.image}`} alt={memory.alt} loading="lazy" decoding="async" />
              {memory.flags?.includes('family-easter-trigger') && (
                <button class="family-easter-trigger" type="button" data-family-easter-trigger aria-label="查看特别插画" title="查看特别插画" data-locale-aria-label-zh="查看特别插画" data-locale-aria-label-en="View the special illustration" data-locale-title-zh="查看特别插画" data-locale-title-en="View the special illustration"><svg class="icon"><use href="#icon-sparkles"></use></svg></button>
              )}
            </div>
            <div class="memory-entry-copy">
              <p class="timeline-date">{memory.date}</p>
              <h3><LocalizedText value={memory.title} /></h3>
              <p><LocalizedText value={memory.description} /></p>
              {memory.place && <p class="place"><LocalizedText value={memory.place} /></p>}
            </div>
          </div>
        </article>
      ))}
    </div>
    <p class="memory-filter-empty" data-memory-filter-empty role="status" hidden><LocalizedText value={COPY['home.noMatches']} /></p>
  </div>
  <p class="closing-note"><LocalizedText value={COPY['home.closing']} /></p>
</section>
