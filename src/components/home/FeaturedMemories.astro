---
import OptimizedImage from '../OptimizedImage.astro';
import LocalizedText from '../LocalizedText.astro';
import { getMemoryById } from '../../data/memories.js';
import { COPY } from '../../i18n/copy.js';

const featuredMemoryIds = ['paper-lanterns', 'mountain-train', 'winter-market'];
const memories = featuredMemoryIds.map((id) => {
  const memory = getMemoryById(id);
  if (!memory) throw new Error(`Featured memory "${id}" was not found.`);
  return memory;
});
const siteBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<section class="featured-memories" aria-labelledby="featured-memories-title">
  <header class="featured-memories-heading">
    <div><p class="section-kicker"><LocalizedText value={COPY['home.storyOutside']} /></p><h2 id="featured-memories-title"><LocalizedText value={COPY['home.featured']} /></h2></div>
    <p><LocalizedText value={COPY['home.featuredIntro']} /></p>
    <a class="scene-link" href={`${siteBase}album/`}><LocalizedText value={COPY['home.openAlbum']} /> <svg class="icon" aria-hidden="true"><use href="#icon-arrow-up-right"></use></svg></a>
  </header>
  <div class="featured-memories-grid">
    {memories.map((memory) => (
      <article class="featured-memory memory-entry">
        <button type="button" class="featured-memory-photo memory-image-frame memory-image-hover" data-story-memory={memory.id} aria-label={`放大查看：${memory.title.zh}`} data-locale-aria-label-zh={`放大查看：${memory.title.zh}`} data-locale-aria-label-en={`View larger: ${memory.title.en}`}>
          <OptimizedImage src={`./assets/images/${memory.image}`} alt={memory.alt} loading="lazy" decoding="async" />
        </button>
        <div class="featured-memory-copy memory-entry-copy"><p class="timeline-date">{memory.date}</p><h3><LocalizedText value={memory.title} /></h3></div>
      </article>
    ))}
  </div>
</section>
