---
import { getImage, Image } from 'astro:assets';
import { getAlbumImageOptions, isVectorImage, resolveAlbumImage, selectImagePreset } from '../lib/image-assets.js';

const { src, alt = '', fullSizeForViewer = false, variant, ...attributes } = Astro.props;
const altZh = typeof alt === 'string' ? alt : alt?.zh ?? alt?.en ?? '';
const altEn = typeof alt === 'string' ? alt : alt?.en ?? alt?.zh ?? '';
const image = resolveAlbumImage(src);
const preset = selectImagePreset({ variant, className: attributes.class });
const vector = isVectorImage(image, src);
const viewerImage = fullSizeForViewer && !vector
  ? await getImage({ src: image, format: 'webp', quality: 85, width: Math.min(image.width || 1600, 1600) })
  : null;
const viewer = fullSizeForViewer
  ? {
      src: viewerImage?.src ?? image.src,
      width: viewerImage?.attributes.width ?? image.width,
      height: viewerImage?.attributes.height ?? image.height,
    }
  : null;
const viewerAttributes = viewer?.width && viewer?.height
  ? { 'data-pswp-src': viewer.src, 'data-pswp-width': viewer.width, 'data-pswp-height': viewer.height }
  : {};
---

{vector ? (
  <img
    src={image.src}
    width={image.width || undefined}
    height={image.height || undefined}
    alt={altZh}
    data-locale-alt-zh={altZh}
    data-locale-alt-en={altEn}
    {...attributes}
    {...viewerAttributes}
  />
) : (
  <Image
    src={image}
    alt={altZh}
    data-locale-alt-zh={altZh}
    data-locale-alt-en={altEn}
    {...getAlbumImageOptions(image, preset)}
    {...attributes}
    {...viewerAttributes}
  />
)}
