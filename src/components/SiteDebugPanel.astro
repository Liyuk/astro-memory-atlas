---
import { SITE_CONFIG } from '../config/site.js';
import LocalizedText from './LocalizedText.astro';
import { COPY } from '../i18n/copy.js';
const { current = 'story' } = Astro.props;
const siteBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const pageNames = { story: COPY['debug.home'], journey: COPY['debug.journey'], album: COPY['debug.album'], annual: COPY['debug.annual'], places: COPY['debug.places'], future: COPY['debug.future'] };
const pages = [['', COPY['debug.home']], ['journey/', COPY['debug.journey']], ['album/', COPY['debug.album']], ['annual/', COPY['debug.annual']], ['places/', COPY['debug.places']], ['future/', COPY['debug.future']]];
---
{SITE_CONFIG.debugPanel && <>
  <button class="debug-launcher" type="button" data-debug-launcher aria-controls="site-debug-panel" aria-expanded="false" hidden><LocalizedText value={COPY['debug.open']} /></button>
  <aside class="debug-panel" id="site-debug-panel" aria-label={COPY['debug.label'].zh} data-locale-aria-label-zh={COPY['debug.label'].zh} data-locale-aria-label-en={COPY['debug.label'].en} data-debug-panel data-current-page={current} data-site-base={siteBase}>
    <div class="debug-panel-head"><div><h2 class="debug-panel-title"><LocalizedText value={COPY['debug.title']} /></h2><p class="debug-panel-note"><LocalizedText value={COPY['debug.currentPage']} values={{ page: pageNames[current] }} /></p></div><button class="debug-panel-close" type="button" data-debug-close aria-label={COPY['debug.collapse'].zh} data-locale-aria-label-zh={COPY['debug.collapse'].zh} data-locale-aria-label-en={COPY['debug.collapse'].en} aria-expanded="true"><svg class="icon"><use href="#icon-x"></use></svg></button></div>
    <section class="debug-panel-section"><h3><LocalizedText value={COPY['debug.time']} /></h3><label class="debug-panel-note" for="debug-datetime"><LocalizedText value={COPY['debug.timeHelp']} /></label><input id="debug-datetime" type="datetime-local" data-debug-datetime><div class="debug-button-grid">
      <button class="debug-button" type="button" data-debug-apply-time><LocalizedText value={COPY['debug.apply']} /></button><button class="debug-button" type="button" data-debug-reset-time><LocalizedText value={COPY['debug.reset']} /></button>
      <button class="debug-button" type="button" data-debug-preset="love"><LocalizedText value={COPY['debug.love']} /></button><button class="debug-button" type="button" data-debug-preset="wedding"><LocalizedText value={COPY['debug.wedding']} /></button>
      {Object.entries(SITE_CONFIG.birthdays).map(([id, person]) => <button class="debug-button" type="button" data-debug-preset={id}><LocalizedText value={COPY['debug.birthday']} values={{ name: person.name }} /></button>)}
    </div></section>
    <section class="debug-panel-section"><h3><LocalizedText value={COPY['debug.pageActions']} /></h3><div class="debug-button-grid">
      {current === 'story' && <><button class="debug-button" type="button" data-debug-action="open-love"><LocalizedText value={COPY['debug.previewLove']} /></button><button class="debug-button" type="button" data-debug-action="open-wedding"><LocalizedText value={COPY['debug.previewWedding']} /></button><button class="debug-button" type="button" data-debug-action="birthday-one"><LocalizedText value={COPY['debug.previewBirthday']} /></button></>}
      {current === 'album' && <><button class="debug-button" type="button" data-debug-action="filter-latest"><LocalizedText value={COPY['debug.filterLatest']} /></button><button class="debug-button" type="button" data-debug-action="clear-filter"><LocalizedText value={COPY['debug.clearFilter']} /></button><button class="debug-button" type="button" data-debug-action="album-open-image"><LocalizedText value={COPY['debug.openImage']} /></button></>}
      {current === 'places' && <><button class="debug-button" type="button" data-debug-action="map-first-location"><LocalizedText value={COPY['debug.firstPlace']} /></button><button class="debug-button" type="button" data-debug-action="map-overview"><LocalizedText value={COPY['debug.mapOverview']} /></button><button class="debug-button" type="button" data-debug-action="map-open-photo"><LocalizedText value={COPY['debug.mapPhoto']} /></button></>}
      <button class="debug-button" type="button" data-debug-run-audit><LocalizedText value={COPY['debug.audit']} /></button>
    </div></section>
    <nav class="debug-panel-section" aria-label={COPY['debug.pageNavigation'].zh} data-locale-aria-label-zh={COPY['debug.pageNavigation'].zh} data-locale-aria-label-en={COPY['debug.pageNavigation'].en}><h3><LocalizedText value={COPY['debug.pageNavigation']} /></h3><div class="debug-button-grid">{pages.map(([path, label]) => <button class="debug-button" type="button" data-debug-page={path}><LocalizedText value={label} /></button>)}</div></nav>
    <p class="debug-panel-status" data-debug-status role="status" aria-live="polite"></p>
  </aside>
</>}
